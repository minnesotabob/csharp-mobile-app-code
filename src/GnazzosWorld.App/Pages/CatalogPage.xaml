<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:catalog="clr-namespace:GnazzosWorld.Core.Catalog;assembly=GnazzosWorld.Core"
             xmlns:vm="clr-namespace:GnazzosWorld.Core.Presentation;assembly=GnazzosWorld.Core"
             xmlns:views="clr-namespace:GnazzosWorld.App.Views"
             xmlns:text="clr-namespace:GnazzosWorld.Core.Localization;assembly=GnazzosWorld.Core"
             x:Class="GnazzosWorld.App.Pages.CatalogPage"
             x:DataType="vm:CatalogBrowserViewModel"
             Title="{x:Static text:UiText.Discover}"
             SizeChanged="OnSizeChanged">
  <Grid x:Name="ContentGrid" Padding="20" ColumnDefinitions="*,0">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
      <SearchBar Placeholder="{x:Static text:UiText.SearchHint}"
                 Text="{Binding Query, Mode=TwoWay}" />
      <Picker Grid.Row="1" Title="{x:Static text:UiText.Filter}"
              ItemsSource="{Binding FilterLabels}"
              SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" />
      <Label Grid.Row="2" Text="{Binding ResultSummary}" />
      <Button Grid.Row="3" Text="{x:Static text:UiText.OpenSelected}"
              Command="{Binding OpenDetails}" />
      <Label Grid.Row="4" Text="{Binding NavigationError}" />
      <CollectionView Grid.Row="5" ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      SelectionMode="Single"
                      EmptyView="{x:Static text:UiText.Empty}">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="catalog:CatalogItem">
            <views:CatalogCard />
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </Grid>
    <views:DetailsView x:Name="DetailPane" Grid.Column="1"
                       BindingContext="{Binding Detail}" IsVisible="False" />
  </Grid>
</ContentPage>
