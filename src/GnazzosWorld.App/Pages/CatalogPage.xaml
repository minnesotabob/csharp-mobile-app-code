<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:catalog="clr-namespace:GnazzosWorld.Core.Catalog;assembly=GnazzosWorld.Core"
             xmlns:vm="clr-namespace:GnazzosWorld.Core.Presentation;assembly=GnazzosWorld.Core"
             xmlns:views="clr-namespace:GnazzosWorld.App.Views"
             xmlns:text="clr-namespace:GnazzosWorld.Core.Localization;assembly=GnazzosWorld.Core"
             x:Class="GnazzosWorld.App.Pages.CatalogPage"
             x:DataType="vm:CatalogBrowserViewModel"
             Title="{x:Static text:UiText.Discover}"
             SizeChanged="OnSizeChanged">
  <Grid x:Name="ContentGrid" Padding="20" ColumnDefinitions="*,0">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <SearchBar Placeholder="{x:Static text:UiText.SearchHint}"
                   Text="{Binding Query, Mode=OneWay}" TextChanged="OnQueryTextChanged" />
        <Button Grid.Column="1" Text="{x:Static text:UiText.Refine}"
                Command="{Binding ToggleFilters}" />
      </Grid>
      <ScrollView Grid.Row="1" MaximumHeightRequest="220"
                  IsVisible="{Binding FiltersExpanded}">
        <VerticalStackLayout Spacing="8">
          <Picker Title="{x:Static text:UiText.Filter}"
                  ItemsSource="{Binding FilterLabels}"
                  SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" />
          <Picker Title="{x:Static text:UiText.CreatorFilter}"
                  ItemsSource="{Binding CreatorLabels}"
                  SelectedIndex="{Binding CreatorIndex, Mode=TwoWay}" />
          <Picker Title="{x:Static text:UiText.Sort}"
                  ItemsSource="{Binding SortLabels}"
                  SelectedIndex="{Binding SortIndex, Mode=TwoWay}" />
          <HorizontalStackLayout Spacing="12">
            <Label Text="{x:Static text:UiText.FavoritesOnly}" VerticalOptions="Center" />
            <Switch IsToggled="{Binding FavoritesOnly, Mode=TwoWay}"
                    SemanticProperties.Description="{x:Static text:UiText.FavoritesOnly}" />
          </HorizontalStackLayout>
          <Button Text="{x:Static text:UiText.RetryFavorites}"
                  Command="{Binding RetryFavorites}" />
        </VerticalStackLayout>
      </ScrollView>
      <Label Grid.Row="2" Text="{Binding ResultSummary}" />
      <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button Text="{x:Static text:UiText.OpenSelected}" Command="{Binding OpenDetails}" />
        <Button Grid.Column="1" Text="{Binding FavoriteAction}" Command="{Binding ToggleFavorite}" />
      </Grid>
      <VerticalStackLayout Grid.Row="4" Spacing="2">
        <Label Text="{Binding NavigationError}" />
        <Label Text="{Binding FavoritesError}" />
        <Label Text="{Binding SearchError}" />
      </VerticalStackLayout>
      <CollectionView Grid.Row="5" ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      SelectionMode="Single"
                      EmptyView="{x:Static text:UiText.Empty}">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="catalog:CatalogItem">
            <views:CatalogCard />
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </Grid>
    <views:DetailsView x:Name="DetailPane" Grid.Column="1"
                       BindingContext="{Binding Detail}" IsVisible="False" />
  </Grid>
</ContentPage>
