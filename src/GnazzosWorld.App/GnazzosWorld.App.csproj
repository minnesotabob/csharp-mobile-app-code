<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net11.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>GnazzosWorld.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Gnazzo's World</ApplicationTitle>
    <ApplicationId>com.johngnazzo.gnazzosworld</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <ProjectReference Include="../GnazzosWorld.Core/GnazzosWorld.Core.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#192D3A" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#192D3A" BaseSize="128,128" />
  </ItemGroup>
</Project>
