<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:catalog="clr-namespace:GnazzosWorld.Core.Catalog;assembly=GnazzosWorld.Core"
             x:Class="GnazzosWorld.App.MainPage"
             Title="Gnazzo's World">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Label Text="Books, music, and stories" FontSize="26"
               SemanticProperties.HeadingLevel="Level1" />
        <SearchBar Grid.Row="1" Placeholder="Search titles or creators"
                   TextChanged="OnSearchChanged" />
        <CollectionView x:Name="CatalogView" Grid.Row="2" SelectionMode="None"
                        EmptyView="No matching content. Try another search.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="catalog:CatalogItem">
                    <VerticalStackLayout Padding="0,12" Spacing="4">
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Creator}" />
                        <Label Text="{Binding Description}" FontSize="14" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
