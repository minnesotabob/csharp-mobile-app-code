<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GnazzosWorld.Core.Presentation;assembly=GnazzosWorld.Core"
             xmlns:loc="clr-namespace:GnazzosWorld.Core.Localization;assembly=GnazzosWorld.Core"
             x:Class="GnazzosWorld.App.Views.DetailsView"
             x:DataType="vm:DetailViewModel">
  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="12">
      <Label Text="{Binding Message}" />
      <Label Text="{Binding Title}" FontSize="26"
             SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{Binding Creator}" />
      <Label Text="{Binding Kind}" />
      <Label Text="{Binding Edition}" />
      <Label Text="{Binding ReleaseDate}" />
      <Label Text="{Binding Duration}" />
      <Label Text="{Binding Advisory}" />
      <Label Text="{Binding Availability}" />
      <Label Text="{Binding Description}" />
      <VerticalStackLayout IsVisible="{Binding HasSample}" Spacing="10">
        <Label Text="{Binding SampleHeading}" FontSize="20"
               SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{Binding SampleCredit}" />
        <Label Text="{Binding SampleText}" />
      </VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding HasExternalLink}" Spacing="8">
        <Label Text="{Binding ExternalHost}" />
        <Button Text="{x:Static loc:UiText.OpenWebsite}"
                Command="{Binding OpenExternal}" />
      </VerticalStackLayout>
      <Label Text="{Binding LinkMessage}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentView>
