<Project>
  <!-- Shared compiler settings; the manuscript audit rechecks these across portable, API, and Android builds. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>15.0</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
